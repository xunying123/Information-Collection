{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "gen-api": "openapi-ts",
    "generate-client": "openapi-ts --input http://localhost:5000/openapi.json --output ./src/client --client axios"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@hey-api/client-axios": "^0.7.1",
    "@hey-api/client-fetch": "^0.10.1",
    "@hey-api/openapi-ts": "^0.67.5",
    "@rushstack/eslint-patch": "^1.11.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.2.0",
    "buffer": "^6.0.3",
    "docxtemplater": "^3.63.0",
    "element-plus": "^2.9.10",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^10.1.0",
    "file-saver": "^2.0.5",
    "globals": "^16.1.0",
    "lodash": "^4.17.21",
    "naive-ui": "^2.41.0",
    "npm-run-all2": "^8.0.3",
    "pinia": "^3.0.2",
    "pizzip": "^3.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.5.0",
    "v-clipboard": "3.0.0-next.1",
    "vite": "^6.3.5",
    "vue": "^3.5.14",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  }
